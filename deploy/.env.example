# Copy to deploy/.env and generate your own secrets. Never commit that file.
POSTGRES_PASSWORD=replace-with-a-unique-password
# Percent-encode password special characters. The host is the Compose service name.
DATABASE_URL=postgresql://bookmark:replace-with-a-unique-password@database:5432/bookmark
JWT_SECRET=replace-with-a-random-secret
NOTION_CLIENT_ID=replace-with-your-own-notion-client-id
NOTION_CLIENT_SECRET=replace-with-your-own-notion-client-secret
# Optional Google sign-in. Both values are required before the server offers it.
# GOOGLE_CLIENT_ID=replace-with-your-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Optional email sign-in. Without RESEND_API_KEY the server prints the code once
# on the console for a personal installation. Do not commit a real key.
# RESEND_API_KEY=replace-with-your-resend-key
# EMAIL_FROM=Bookmark Assistant <login@example.com>
ALLOWED_EXTENSION_IDS=replace-with-your-unpacked-extension-id
# Optional AI support: AES-256-GCM keyring with a separate random 32-byte base64url key.
# AI_CREDENTIAL_ENCRYPTION_KEYS=1:replace-with-a-random-base64url-key
AI_CREDENTIAL_ACTIVE_KEY_VERSION=1
PORT=3333
