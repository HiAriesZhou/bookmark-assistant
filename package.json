{
  "name": "bookmark-assistant",
  "version": "1.4.4",
  "description": "Open-source local bookmark manager with optional Notion sync, AI enrichment, and hosted-service billing.",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -F @bookmark-assistant/extension dev",
    "dev:server": "pnpm -F @bookmark-assistant/server dev",
    "dev:website": "pnpm -F @bookmark-assistant/website dev",
    "build": "pnpm -F @bookmark-assistant/extension build",
    "package": "pnpm -F @bookmark-assistant/extension build:zip",
    "build:zip": "pnpm package",
    "version:sync": "node scripts/sync-product-version.mjs",
    "version:check": "node scripts/sync-product-version.mjs --check",
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "brand:check": "node scripts/sync-brand-assets.mjs --check",
    "resources:sync": "pnpm version:sync && pnpm marketing:copy:sync && pnpm brand:sync",
    "resources:check": "pnpm version:check && pnpm brand:check && pnpm marketing:copy:check && node scripts/check-public-resources.mjs",
    "build:server": "pnpm -F @bookmark-assistant/server build",
    "build:website": "pnpm -F @bookmark-assistant/website build",
    "build:all": "pnpm -r build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm test:e2e:extension",
    "test:e2e:extension": "VITE_OAUTH_SERVER_URL=http://localhost:3333 pnpm build:prod && BOOKMARK_ASSISTANT_RELEASE_CHROME=0 BOOKMARK_ASSISTANT_EXTENSION_BUILD=dist BOOKMARK_ASSISTANT_EXPECTED_API_ORIGIN=http://localhost:3333 playwright test -c playwright.extension.config.ts",
    "test:e2e:extension:local": "pnpm -F @bookmark-assistant/extension build:dev && BOOKMARK_ASSISTANT_RELEASE_CHROME=0 BOOKMARK_ASSISTANT_EXTENSION_BUILD=dist-dev BOOKMARK_ASSISTANT_EXPECTED_API_ORIGIN=http://localhost:3334 playwright test -c playwright.extension.config.ts",
    "test:e2e:release:chrome": "pnpm build:prod && BOOKMARK_ASSISTANT_RELEASE_CHROME=1 BOOKMARK_ASSISTANT_EXTENSION_BUILD=dist playwright test -c playwright.extension.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "prepare": "husky",
    "start:server": "pnpm -F @bookmark-assistant/server start",
    "start:website": "pnpm -F @bookmark-assistant/website start",
    "check:i18n": "node scripts/check-i18n.js",
    "marketing:copy:sync": "pnpm -F @bookmark-assistant/marketing copy:sync",
    "marketing:copy:check": "pnpm -F @bookmark-assistant/marketing copy:check",
    "marketing:render": "pnpm -F @bookmark-assistant/marketing render",
    "marketing:validate": "pnpm -F @bookmark-assistant/marketing validate",
    "marketing:contact-sheet": "pnpm -F @bookmark-assistant/marketing contact-sheet",
    "marketing:package": "pnpm -F @bookmark-assistant/marketing package",
    "marketing:approve-store-assets": "pnpm -F @bookmark-assistant/marketing approve-store-assets",
    "marketing:approve-website-assets": "pnpm -F @bookmark-assistant/marketing approve-website-assets",
    "marketing:sync-website-assets": "pnpm -F @bookmark-assistant/marketing sync-website-assets",
    "build:prod": "pnpm -F @bookmark-assistant/extension build:prod",
    "source:snapshot": "node scripts/export-source-snapshot.mjs",
    "source:check": "node scripts/check-open-source.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.14.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "express": "^4.18.2",
    "globals": "^16.4.0",
    "husky": "^9.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.0.0",
    "terser": "^5.44.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.15",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "author": "Aries",
  "license": "GPL-3.0-only",
  "homepage": "https://bookmarkassistant.com"
}
