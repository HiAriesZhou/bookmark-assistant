# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3333
NODE_ENV=development

# Deployment edition
# SELF_HOSTED=true grants local Pro-level limits for self-hosted deployments.
SELF_HOSTED=true
EDITION=self-hosted

# Developer, gift and trial Pro grants are stored per account; use the local
# `pnpm -F @bookmark-assistant/server entitlement` command to manage them.

# Paddle Billing. Price IDs are public catalog identifiers; API and webhook
# credentials must only be configured in private deployment settings.
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_PRO_MONTHLY_PRICE_ID=
# PADDLE_PRO_YEARLY_PRICE_ID=

# Website URL (for OAuth success redirects)
# Development: http://localhost:3006
# Production: https://bookmark-assistant.vercel.app
WEBSITE_URL=http://localhost:3006

# ============================================
# SECURITY (CRITICAL)
# ============================================
# Generate a strong JWT secret:
#   openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Chrome extension allowlist. Use a comma-separated list for the Chrome Web
# Store extension and any local unpacked test builds.
ALLOWED_EXTENSION_IDS=chrome-web-store-id,local-unpacked-extension-id

# ============================================
# NOTION API CONFIGURATION
# ============================================
# Get these from: https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
NOTION_API_VERSION=2025-09-03

# Optional Google sign-in. The client ID is public; the secret stays on the server.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional email sign-in via Resend. Self-hosted servers without this key print
# the one-time code once on the console. Hosted servers without it disable email
# sign-in. Do not commit a real key.
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=Bookmark Assistant <login@bookmarkassistant.com>

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Example: <postgresql-connection-url>
DATABASE_URL=your-database-connection-string
# Optional PostgreSQL TLS override for local environments only. Do not set this
# in production unless the database provider explicitly requires it.
# DATABASE_SSLMODE=disable
# Optional local override for low-capacity session poolers.
# DATABASE_CONNECTION_LIMIT=5
# Optional when DATABASE_URL is already a direct/session connection. Hosted
# serverless deployments should use a direct or session-pooler URL here so
# Prisma migrations do not run through the transaction pooler.
DIRECT_URL=your-direct-or-session-database-connection-string

# ============================================
# AI CREDENTIAL ENCRYPTION
# ============================================
# Versioned, base64url-encoded 32-byte AES-256-GCM keys. Do not reuse JWT_SECRET,
# do not commit real values, and set these only in sensitive deployment settings.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AI_CREDENTIAL_ENCRYPTION_KEYS=1:replace-with-a-base64url-encoded-32-byte-key
# AI_CREDENTIAL_ACTIVE_KEY_VERSION=1

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
# Optional: Customize rate limiting
# AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# AUTH_RATE_LIMIT_MAX=10            # 10 requests per window
# API_RATE_LIMIT_WINDOW_MS=60000    # 1 minute
# API_RATE_LIMIT_MAX=100            # 100 requests per window

# ============================================
# DESCRIPTION EXTRACTION CONFIGURATION
# ============================================
# Optional: Tune description extraction performance
# DESCRIPTION_EXTRACTION_BATCH_SIZE=5
# DESCRIPTION_EXTRACTION_BATCH_DELAY=100
# DESCRIPTION_EXTRACTION_TIMEOUT=5000

# Keep optional descriptions inside the Vercel function window and preserve
# enough time for required Notion writes. Values are milliseconds.
# SYNC_REQUEST_BUDGET_MS=240000
# SYNC_DESCRIPTION_BUDGET_MS=180000
# SYNC_BASE_SYNC_RESERVE_MS=60000
