# Website Environment Variables

# The site is the official build unless this names another site (as for the extension).
# VITE_WEBSITE_URL=https://your-project.example
# Canonical URL of a site that is not the official one
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional links for a site that is not the official one (never put secrets in NEXT_PUBLIC variables)
# NEXT_PUBLIC_INSTALL_URL=https://your-project.example/install
# NEXT_PUBLIC_SOURCE_URL=https://your-source.example
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.test

# Legacy server origin for the /api rewrite, used only by older extension versions
# API_URL=http://localhost:3333

# Production shows released claims only. Preview also renders prepared claims for review.
NEXT_PUBLIC_WEBSITE_CHANNEL=released
