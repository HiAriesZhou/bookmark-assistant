# Website Environment Variables

# Public website configuration
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional links for a website that is not the official service (never put secrets in NEXT_PUBLIC variables)
# NEXT_PUBLIC_INSTALL_URL=https://your-project.example/install
# NEXT_PUBLIC_SOURCE_URL=https://your-source.example
# NEXT_PUBLIC_NOTION_TEMPLATE_URL=https://your-template.example
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.test

# Paddle.js for /checkout. The client-side token is public; it must match the environment.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Extra extension IDs allowed to embed /checkout, e.g. a local unpacked build.
# CHECKOUT_EXTENSION_IDS=

# Production shows released claims only. Preview also renders prepared claims for review.
NEXT_PUBLIC_WEBSITE_CHANNEL=released
