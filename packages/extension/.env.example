# Chrome Extension Environment Variables
# These variables are embedded at build time by Vite. Never put secrets here.

# The build is official unless it is a development build or this names another site.
# VITE_WEBSITE_URL=https://your-project.example

# Links for a build that is not the official one
# VITE_FAQ_URL=https://your-project.example/#faq
# VITE_PRIVACY_URL=https://your-project.example/privacy
# VITE_TERMS_URL=https://your-project.example/terms
# Optional: GPL source of this build (defaults to the upstream repository)
# VITE_SOURCE_URL=https://github.com/your-org/bookmark-assistant
