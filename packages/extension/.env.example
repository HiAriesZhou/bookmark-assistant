# Chrome Extension Environment Variables
# These variables are embedded at build time by Vite

# OAuth Server Configuration
VITE_OAUTH_SERVER_URL=http://localhost:3333

# Notion OAuth Application
VITE_NOTION_CLIENT_ID=your-notion-client-id

# Website URL (for payment success redirects)
VITE_WEBSITE_URL=http://localhost:3001

# Optional: Support/Billing URLs
# VITE_SUPPORT_URL=https://your-project.example/support
# Optional: GPL source of this build (defaults to the upstream repository)
# VITE_SOURCE_URL=https://github.com/your-org/bookmark-assistant

# Debug Settings (optional)
VITE_DEBUG_MODE=false
