{
  "name": "@bookmark-assistant/extension",
  "version": "1.5.0",
  "private": true,
  "description": "Manage Chrome bookmarks locally, sync bookmarks and Reading List to Notion, and optionally add AI summaries and tags.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-product-version.mjs --check && node ../../scripts/sync-brand-assets.mjs --check && node ../marketing/scripts/copy.mjs --check",
    "build": "tsc -b && vite build --mode development",
    "build:dev": "tsc -b && vite build --mode development",
    "prebuild:prod": "node ../../scripts/sync-product-version.mjs --check && node ../../scripts/sync-brand-assets.mjs --check && node ../marketing/scripts/copy.mjs --check",
    "build:prod": "tsc -b && node scripts/build-production.js",
    "build:zip": "node ../../scripts/sync-product-version.mjs && node ../../scripts/sync-brand-assets.mjs && node ../marketing/scripts/copy.mjs --write && node ../../scripts/sync-product-version.mjs --check && node ../../scripts/sync-brand-assets.mjs --check && node ../marketing/scripts/copy.mjs --check && npm run clean && node scripts/build-zip.js",
    "clean": "rm -rf dist dist-dev",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bookmark-assistant/shared": "workspace:*",
    "@bookmark-assistant/types": "workspace:*",
    "@notionhq/client": "^5.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^13.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "jszip": "^3.10.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.9.2",
    "vite": "^5.0.8",
    "zustand": "^4.5.7"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=18.0.0"
  }
}
